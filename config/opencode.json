{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/glm-5.3-flash-free",
  "plugins": [
    {
      "package": "opencode-runtime-fallback",
      "options": {
        "fallback_models": [
          "opencode/glm-5.3-flash-free",
          "opencode/mimo-v2.6-flash-free",
          "google/gemini-flash-lite-latest",
          "openrouter/openrouter/free"
        ],
        "timeout_seconds": 30
      }
    }
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
        "codemode": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "shell": {
      "*": "allow",
      "rm -rf *": "ask",
      "Remove-Item *-Recurse*": "ask",
      "del /s*": "ask",
      "rd /s*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "gh repo *": "ask",
      "gh pr merge*": "ask",
      "gh release *": "ask"
    }
  }
}
